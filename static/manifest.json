{
  "manifest_version": 3,
  "name": "AI Chat Exporter",
  "version": "0.1.0",
  "description": "Export conversations from major AI chats to PDF or Markdown.",
  "action": {
    "default_title": "Export AI chat",
    "default_popup": "popup/index.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "downloads"]
}
