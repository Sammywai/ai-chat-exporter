{
  "manifest_version": 3,
  "name": "AI Chat Exporter",
  "version": "0.4.1",
  "minimum_chrome_version": "116",
  "description": "Export conversations from major AI chats to PDF or Markdown.",
  "action": {
    "default_title": "Export AI chat",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "popup/index.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "sidePanel"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
